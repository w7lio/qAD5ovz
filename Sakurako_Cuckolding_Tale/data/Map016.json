se,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"temple_people","direction":2,"pattern":2,"characterIndex":4},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":7,"y":7},{"id":2,"name":"EV002","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"temple_people","direction":2,"pattern":1,"characterIndex":7},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":9,"y":7},{"id":3,"name":"EV003","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"character1","direction":8,"pattern":1,"characterIndex":2},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Cảnh quay mà các con vừa xem là bản sao của một thứ đã được đăng lên trang phát trực tuyến video mới hôm kia."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["May mắn thay, trước khi nó kịp lan truyền, chúng ta đã thực hiện nghi lễ thanh tẩy lên đoạn phim đó và ngăn chặn buổi phát sóng…"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["…Con Yêu Quái bị phong ấn trong Tiểu Đền thờ vẫn đang mất tích."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Thông thường, chúng ta nên đích thân đến hiện trường và xử lý vấn đề này…"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Không may thay, cả ta và nữ tu hiện tại đều không thể rời khỏi nơi này do còn phải chuẩn bị sơ bộ cho Lễ Hội Requiem sắp tới vào mùa sau."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Vì vậy, ta muốn giao phó trọng trách này cho hai con…."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Hai con có nhận lời không？"]},{"code":401,"indent":0,"parameters":["Takimaru-dono, Sakurako-dono."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru & Sakurako"]},{"code":401,"indent":0,"parameters":["Vâng, tất nhiên rồi ạ…!"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Hô hô hô. Tốt lắm."]},{"code":401,"indent":0,"parameters":["Nếu hai con đến hiện trường, việc này coi như đã được giải quyết."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Dù sao thì, Sakurako-dono."]},{"code":401,"indent":0,"parameters":["Con là đương kim gia chủ của một trong những trường phái Onmyōdō của chúng ta, \"Tsuchimikado-ryū Onmyōdō\", và là một hành giả hàng đầu xứng đáng với vị trí đó."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Gần đây, trong giới hành giả, không ít người gọi con là \\C[10]\"Onmyoji Đỉnh Cao Thời Hiện Đại\"\\C[0]…."]},{"code":213,"indent":0,"parameters":[-1,7,false]},{"code":117,"indent":0,"parameters":[6]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Muu… Trụ trì, xin đừng trêu con quá…."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Hô hô, ta xin lỗi."]},{"code":401,"indent":0,"parameters":["Tật xấu của ta lại tái phát rồi."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Trụ trì"]},{"code":401,"indent":0,"parameters":["Giờ thì, đùa vậy đủ rồi…"]},{"code":401,"indent":0,"parameters":["Hai con, ta trông cậy vào việc xử lý Yêu Quái."]},{"code":221,"indent":0,"parameters":[]},{"code":205,"indent":0,"parameters":[2,{"list":[{"code":39,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":39,"indent":null}]},{"code":205,"indent":0,"parameters":[1,{"list":[{"code":39,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":39,"indent":null}]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":4,"indent":null},{"code":17,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":17,"indent":null}]},{"code":205,"indent":0,"parameters":[3,{"list":[{"code":4,"indent":null},{"code":18,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":505,"indent":0,"parameters":[{"code":18,"indent":null}]},{"code":222,"indent":0,"parameters":[]},{"code":213,"indent":0,"parameters":[-1,7,true]},{"code":117,"indent":0,"parameters":[6]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Haizz……"]},{"code":401,"indent":0,"parameters":["Dạo này toàn là những kẻ tội lỗi thôi…."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Phát trực tiếp cái này, thử thách liều lĩnh cái kia… Sao ai ai cũng có thể tự tiện xông vào đền thờ bỏ hoang hay phá hủy những ngôi đền nhỏ mà không chút lo lắng gì vậy…？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Dù rằng lần nào cũng chính chúng tôi là người phải dọn dẹp đống hỗn độn…"]},{"code":401,"indent":0,"parameters":["Tôi ước gì họ nghĩ một chút đến áp lực tinh thần cho chúng tôi…."]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Ứ… Nói thật, khi chuyện này xảy ra quá nhiều lần thế này, đến động lực và năng lượng của tôi cũng bắt đầu cạn kiệt rồi…."]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru"]},{"code":401,"indent":0,"parameters":["Thôi nào, Sakurako-sama. Tôi rất hiểu cảm xúc của ngài, nhưng…"]},{"code":401,"indent":0,"parameters":["Người có lỗi lần này là kẻ phát trực tiếp đã quay video đó, chứ không phải người dân trong làng có thể trở thành nạn nhân, đúng không ạ？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru"]},{"code":401,"indent":0,"parameters":["\\C[10]Bảo vệ kẻ yếu khỏi nanh vuốt của cái ác.\\c[0] Đó chẳng phải là sứ mệnh của Onmyōdō chúng ta, được truyền lại từ thời xa xưa sao？"]},{"code":117,"indent":0,"parameters":[6]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Ứ… Ờ-ừm, điều đó thì đúng, nhưng…."]},{"code":235,"indent":0,"parameters":[1]},{"code":213,"indent":0,"parameters":[0,8,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru"]},{"code":401,"indent":0,"parameters":["…Đã hiểu. Vậy thì, khi nhiệm vụ này kết thúc, tôi sẽ lại chuẩn bị một bữa cơm nhà làm cho ngài. Liệu ngài có thể lấy lại tinh thần vì điều đó không…？"]},{"code":213,"indent":0,"parameters":[-1,7,true]},{"code":117,"indent":0,"parameters":[6]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["……Haizz. Được rồi, được rồi. Nếu Takimaru đã quan tâm đến vậy, thì tôi cũng không còn cách nào khác ngoài việc phải cố gắng hết sức thôi."]},{"code":117,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Hết cách rồi. Nào, hãy lấy lại tinh thần và cố gắng hết sức nhé…!"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru"]},{"code":401,"indent":0,"parameters":["Tốt quá rồi…!"]},{"code":401,"indent":0,"parameters":["Vậy thì, chúng ta hãy cùng nhau cố gắng trong nhiệm vụ này nữa, Sakurako-sama…!"]},{"code":117,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Ừ, một khi đã quyết làm thì sẽ dốc toàn lực…!"]},{"code":401,"indent":0,"parameters":["Và rồi chúng ta sẽ nhanh chóng giải quyết vụ lộn xộn này… và thưởng thức bữa cơm nhà làm ngon tuyệt của Takimaru♪"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Dù sao thì, tài nấu ăn của Takimaru là tuyệt hảo, ở đẳng cấp có thể tranh ngôi nhất Nhật Bản! Tôi không thể chờ thêm được nữa…♪"]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,2,"Takimaru"]},{"code":401,"indent":0,"parameters":["Ahaha… Thật là vinh dự khi nhận được lời khen như vậy."]},{"code":213,"indent":0,"parameters":[-1,8,true]},{"code":117,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["…Này, nhân tiện tôi mới nhớ ra. Không phải tôi đã nói điều này trước đây rồi sao？"]},{"code":401,"indent":0,"parameters":["Takimaru, khi nào cậu mới chịu bỏ cách nói chuyện kính cẩn đó đi？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Sakurako"]},{"code":401,"indent":0,"parameters":["Nếu trí nhớ của tôi không nhầm thì tôi nghĩ mình đã hỏi câu này khoảng mười l